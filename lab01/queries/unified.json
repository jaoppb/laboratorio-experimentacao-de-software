{
    "config": {
        "connections": 4,
        "optimal_batch_size": 100,
        "cost": 1
    },
    "extractors": {
        "repo": "repo.get('nameWithOwner')",
        "created_at": "repo.get('createdAt')",
        "age_days": "(datetime.now(timezone.utc) - datetime.fromisoformat(repo['createdAt'].replace('Z', '+00:00'))).days if repo.get('createdAt') else None",
        "stargazer_count": "repo.get('stargazerCount')",
        "fork_count": "repo.get('forkCount')",
        "watchers_count": "repo.get('watchers', {}).get('totalCount') if repo.get('watchers') else None",
        "disk_usage_kb": "repo.get('diskUsage')",
        "is_archived": "repo.get('isArchived')",
        "is_fork": "repo.get('isFork')",
        "merged_pull_requests": "repo.get('mergedPRs', {}).get('totalCount', 0)",
        "open_pull_requests": "repo.get('openPRs', {}).get('totalCount', 0)",
        "total_pull_requests": "repo.get('totalPRs', {}).get('totalCount', 0)",
        "total_releases": "repo.get('releases', {}).get('totalCount', 0)",
        "updated_at": "repo.get('updatedAt')",
        "time_since_update_days": "(datetime.now(timezone.utc) - datetime.fromisoformat(repo['updatedAt'].replace('Z', '+00:00'))).days if repo.get('updatedAt') else None",
        "primary_language": "repo.get('primaryLanguage', {}).get('name') if repo.get('primaryLanguage') else None",
        "closed_issues": "repo.get('closedIssues', {}).get('totalCount', 0)",
        "open_issues": "repo.get('openIssues', {}).get('totalCount', 0)",
        "total_issues": "(repo.get('closedIssues', {}).get('totalCount', 0) or 0) + (repo.get('openIssues', {}).get('totalCount', 0) or 0)",
        "closed_issues_ratio": "(repo.get('closedIssues', {}).get('totalCount', 0) / ((repo.get('closedIssues', {}).get('totalCount', 0) or 0) + (repo.get('openIssues', {}).get('totalCount', 0) or 0))) if ((repo.get('closedIssues', {}).get('totalCount', 0) or 0) + (repo.get('openIssues', {}).get('totalCount', 0) or 0)) > 0 else None"
    }
}